+// iOS patch 0009: a GDFX disc image is mapped as a whole, which fails on iOS for a 7-8 GB disc
+// image (the process cannot map that much). When mapping fails, the image is read with pread
+// instead: the parser reads its directory tables, and Read() reads file data on demand. View()
+// then has no bytes to show, and callers fall back to Read().
+class DiscImageFile {
+ public:
+  ~DiscImageFile() {
+#if !defined(_WIN32)
+    if (fd_ >= 0) {
+      close(fd_);
+    }
+#endif
+  }
+
+  static std::unique_ptr<DiscImageFile> Open(const std::filesystem::path& path, std::string& why) {
+#if defined(_WIN32)
+    (void)path;
+    why = "reading without mapping is not supported on Windows";
+    return nullptr;
+#else
+    const int fd = open(path.c_str(), O_RDONLY);
+    if (fd < 0) {
+      why = std::format("open: {}", std::strerror(errno));
+      return nullptr;
+    }
+    struct stat info {};
+    if (fstat(fd, &info) != 0) {
+      why = std::format("fstat: {}", std::strerror(errno));
+      close(fd);
+      return nullptr;
+    }
+    auto file = std::unique_ptr<DiscImageFile>(new DiscImageFile());
+    file->fd_ = fd;
+    file->size_ = static_cast<u64>(info.st_size);
+    return file;
+#endif
+  }
+
+  [[nodiscard]] u64 GetSize() const { return size_; }
+
+  // Reads exactly length bytes at offset; thread safe (pread keeps no file position).
+  bool Read(u64 offset, void* out, size_t length) const {
+#if defined(_WIN32)
+    (void)offset;
+    (void)out;
+    return length == 0;
+#else
+    if (offset > size_ || size_ - offset < length) {
+      return false;
+    }
+    auto* bytes = static_cast<u8*>(out);
+    while (length > 0) {
+      const ssize_t got = pread(fd_, bytes, length, static_cast<off_t>(offset));
+      if (got < 0 && errno == EINTR) {
+        continue;
+      }
+      if (got <= 0) {
+        return false;
+      }
+      bytes += got;
+      offset += static_cast<u64>(got);
+      length -= static_cast<size_t>(got);
+    }
+    return true;
+#endif
+  }
+
+ private:
+  DiscImageFile() = default;
+  int fd_ = -1;
+  u64 size_ = 0;
+};
