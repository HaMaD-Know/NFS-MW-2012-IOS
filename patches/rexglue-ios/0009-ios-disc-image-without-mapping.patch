+// iOS patch 0009: the parser reads through an ImageReader, so a disc image does not have to be
+// mapped as a whole. A mapped image is read through a reader over its span.
+ImageReader SpanReader(std::span<const u8> image) {
+  return [image](u64 offset, void* out, size_t length) {
+    if (!IsInBounds(image, offset, length)) {
+      return false;
+    }
+    std::memcpy(out, image.data() + offset, length);
+    return true;
+  };
+}
+
+bool MagicAt(const ImageReader& read_bytes, u64 offset) {
+  std::array<char, kMagic.size()> found{};
+  return read_bytes(offset, found.data(), found.size()) &&
+         std::memcmp(found.data(), kMagic.data(), kMagic.size()) == 0;
 }
 
