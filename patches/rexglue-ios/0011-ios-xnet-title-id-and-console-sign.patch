+// iOS patch 0011: XNetLogonGetTitleID was a stub that set no return value, so a title got its
+// own first argument back (NFS Most Wanted 2012 then read through a null pointer at its press
+// start screen). On a console it returns the title ID of the running title.
+REX_XAM_BODY(__imp__XNetLogonGetTitleID, rex::xam::XamGetCurrentTitleId_entry)
 REX_XAM_BODY(__imp__XamGetExecutionId, rex::xam::XamGetExecutionId_entry)
