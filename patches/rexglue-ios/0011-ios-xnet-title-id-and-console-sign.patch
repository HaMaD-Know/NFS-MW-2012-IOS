diff --git a/src/kernel/xboxkrnl/xboxkrnl_crypt.cpp b/src/kernel/xboxkrnl/xboxkrnl_crypt.cpp
index e9bdf11..1d95866 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_crypt.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_crypt.cpp
@@ -1272,9 +1272,14 @@ u32 XeKeysHmacShaUsingKey_entry(MappedVoid obscured_key, MappedVoid inp_1, u32 i
 }
 
 u32 XeKeysConsolePrivateKeySign_entry([[maybe_unused]] MappedVoid hash,
-                                      [[maybe_unused]] MappedVoid signature) {
-  REX_KERNEL_STUB("XeKeysConsolePrivateKeySign");
-  return 0;
+                                      MappedVoid signature) {
+  // iOS patch 0011: there is no console key to sign with. Report success with an empty
+  // certificate and signature (XE_CONSOLE_SIGNATURE, 0x228 bytes), as Xenia does, instead of
+  // failing: NFS Most Wanted 2012 retried the failed call several times a second.
+  if (signature) {
+    std::memset(signature.As<u8*>(), 0, 0x228);
+  }
+  return 1;
 }
 
 u32 XeKeysConsoleSignatureVerification_entry([[maybe_unused]] MappedVoid hash,
