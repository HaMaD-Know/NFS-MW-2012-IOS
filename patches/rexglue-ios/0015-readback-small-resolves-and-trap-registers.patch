 }
 
 void InvalidFunctionTrap(PPCContext& ctx, u8* /*base*/) {
-  REXCPU_FATAL("Call to invalid or unregistered function at guest address 0x{:08X}",
-               ctx.last_indirect_target);
+  // iOS patch 0015: also the return address and the argument and object registers, so the
+  // object behind a null callback can be found.
+  REXCPU_FATAL(
+      "Call to invalid or unregistered function at guest address 0x{:08X} (lr 0x{:08X}, r1 "
+      "0x{:08X}, r3 0x{:08X}, r4 0x{:08X}, r5 0x{:08X}, r29 0x{:08X}, r30 0x{:08X}, r31 0x{:08X})",
+      ctx.last_indirect_target, static_cast<u32>(ctx.lr), ctx.r1.u32, ctx.r3.u32, ctx.r4.u32,
+      ctx.r5.u32, ctx.r29.u32, ctx.r30.u32, ctx.r31.u32);
 }
 
 }  // namespace
