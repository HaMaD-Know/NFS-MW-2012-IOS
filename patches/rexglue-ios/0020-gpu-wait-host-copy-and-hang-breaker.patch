   return true;
 }
 
+bool VulkanCommandProcessor::ReadHostGpuWord(u32 guest_address, u32* stored_out) {
+  static u32 failures_logged = 0;
+  auto fail = [](const char* reason) {
+    if (failures_logged++ < 8) {
+      REXGPU_WARN("ReadHostGpuWord failed: {}", reason);
+    }
+    return false;
+  };
+  if (texture_cache_->IsDrawResolutionScaled()) {
+    return fail("draw resolution scaling is active");
+  }
+  const gpu::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const gpu::vulkan::VulkanDevice::Functions& dfn = vulkan_device->GetFunctions();
+  const VkDevice device = vulkan_device->GetDevice();
+  if (wait_readback_buffer_ == VK_NULL_HANDLE) {
+    if (!gpu::vulkan::objects::CreateDedicatedAllocationBuffer(
+            vulkan_device, 256, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+            gpu::vulkan::objects::MemoryPurpose::kReadback, wait_readback_buffer_,
+            wait_readback_memory_)) {
+      wait_readback_buffer_ = VK_NULL_HANDLE;
+      wait_readback_memory_ = VK_NULL_HANDLE;
+      return fail("buffer creation");
+    }
+    if (dfn.vkMapMemory(device, wait_readback_memory_, 0, VK_WHOLE_SIZE, 0,
+                        &wait_readback_mapping_) != VK_SUCCESS) {
+      wait_readback_mapping_ = nullptr;
+    }
+  }
+  if (!wait_readback_mapping_) {
+    return fail("buffer mapping");
+  }
+  if (!submission_open_ && !BeginSubmission(true)) {
+    return fail("BeginSubmission");
+  }
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  SubmitBarriers(true);
+  VkBufferCopy region = {};
+  region.srcOffset = guest_address;
+  region.dstOffset = 0;
+  region.size = 4;
+  deferred_command_buffer_.CmdVkCopyBuffer(shared_memory_->GetBuffer(), wait_readback_buffer_, 1,
+                                           &region);
+  PushBufferMemoryBarrier(wait_readback_buffer_, 0, 4, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_HOST_READ_BIT);
+  if (!AwaitAllQueueOperationsCompletion()) {
+    return fail("AwaitAllQueueOperationsCompletion");
+  }
+  VkMappedMemoryRange mapped_range = {};
+  mapped_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+  mapped_range.memory = wait_readback_memory_;
+  mapped_range.offset = 0;
+  mapped_range.size = VK_WHOLE_SIZE;
+  dfn.vkInvalidateMappedMemoryRanges(device, 1, &mapped_range);
+  std::memcpy(stored_out, wait_readback_mapping_, 4);
+  return true;
+}
