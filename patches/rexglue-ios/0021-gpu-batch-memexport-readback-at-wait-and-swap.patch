+bool VulkanCommandProcessor::FlushPendingGpuWrites() {
+  if (pending_memexport_ranges_.empty()) {
+    return false;
+  }
+  static u32 failures_logged = 0;
+  auto fail = [this](const char* reason) {
+    if (failures_logged++ < 8) {
+      REXGPU_WARN("FlushPendingGpuWrites failed: {}", reason);
+    }
+    pending_memexport_ranges_.clear();
+    return false;
+  };
+  u32 total_size = 0;
+  for (const draw_state::MemExportRange& range : pending_memexport_ranges_) {
+    total_size += range.size_bytes;
+  }
+  if (!total_size) {
+    pending_memexport_ranges_.clear();
+    return false;
+  }
+  const gpu::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const gpu::vulkan::VulkanDevice::Functions& dfn = vulkan_device->GetFunctions();
+  const VkDevice device = vulkan_device->GetDevice();
+  // The same steps as IssueDrawMemexportReadbackFullPath, for all pending ranges at once.
+  VkBuffer readback_buffer = VK_NULL_HANDLE;
+  VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+  if (!gpu::vulkan::objects::CreateDedicatedAllocationBuffer(
+          vulkan_device, total_size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          gpu::vulkan::objects::MemoryPurpose::kReadback, readback_buffer, readback_memory)) {
+    return fail("buffer creation");
+  }
+  if (!submission_open_ && !BeginSubmission(true)) {
+    dfn.vkDestroyBuffer(device, readback_buffer, nullptr);
+    dfn.vkFreeMemory(device, readback_memory, nullptr);
+    return fail("BeginSubmission");
+  }
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  SubmitBarriers(true);
+  u32 readback_offset = 0;
+  for (const draw_state::MemExportRange& range : pending_memexport_ranges_) {
+    VkBufferCopy region = {};
+    region.srcOffset = range.base_address_dwords << 2;
+    region.dstOffset = readback_offset;
+    region.size = range.size_bytes;
+    deferred_command_buffer_.CmdVkCopyBuffer(shared_memory_->GetBuffer(), readback_buffer, 1,
+                                             &region);
+    readback_offset += range.size_bytes;
+  }
+  PushBufferMemoryBarrier(readback_buffer, 0, total_size, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_HOST_READ_BIT);
+  if (!AwaitAllQueueOperationsCompletion()) {
+    dfn.vkDestroyBuffer(device, readback_buffer, nullptr);
+    dfn.vkFreeMemory(device, readback_memory, nullptr);
+    return fail("AwaitAllQueueOperationsCompletion");
+  }
+  void* mapping = nullptr;
+  if (dfn.vkMapMemory(device, readback_memory, 0, VK_WHOLE_SIZE, 0, &mapping) != VK_SUCCESS) {
+    dfn.vkDestroyBuffer(device, readback_buffer, nullptr);
+    dfn.vkFreeMemory(device, readback_memory, nullptr);
+    return fail("vkMapMemory");
+  }
+  VkMappedMemoryRange mapped_range = {};
+  mapped_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+  mapped_range.memory = readback_memory;
+  mapped_range.offset = 0;
+  mapped_range.size = VK_WHOLE_SIZE;
+  dfn.vkInvalidateMappedMemoryRanges(device, 1, &mapped_range);
+  const u8* bytes = reinterpret_cast<const u8*>(mapping);
+  for (const draw_state::MemExportRange& range : pending_memexport_ranges_) {
+    if (u8* destination =
+            GetPhysicalForWrite(physical_memory_, range.base_address_dwords << 2, range.size_bytes)) {
+      std::memcpy(destination, bytes, range.size_bytes);
+    }
+    bytes += range.size_bytes;
+  }
+  dfn.vkUnmapMemory(device, readback_memory);
+  dfn.vkDestroyBuffer(device, readback_buffer, nullptr);
+  dfn.vkFreeMemory(device, readback_memory, nullptr);
+  static u32 flushes_logged = 0;
+  if (flushes_logged++ < 4) {
+    REXGPU_WARN("FlushPendingGpuWrites: copied {} memory export ranges ({} bytes)",
+                pending_memexport_ranges_.size(), total_size);
+  }
+  pending_memexport_ranges_.clear();
+  return true;
+}
